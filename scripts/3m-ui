#!/bin/sh
# 3m-ui unified management entrypoint (/usr/local/bin/3m-ui).
# Application binary: /usr/local/lib/3m-ui/3m-ui-bin
# Original work for 3m-ui (EPL-2.0). Ideas inspired by common panel ops menus;
# not a derivative of any third-party management script source.
#
# UI layer (added): POSIX-sh ANSI menu with automatic fallback to the classic
# plain-text menu, plus a zh/en language switch. Business logic unchanged.

set -eu

ROOT="${THREE_M_UI_ROOT:-}"
BASE="$ROOT/usr/local/lib/3m-ui"
MANAGER="$BASE/3m-ui.sh"
INSTALLER="$BASE/install.sh"
UPDATER="$BASE/update.sh"
UNINSTALLER="$BASE/uninstall.sh"
APP_BIN="$BASE/3m-ui-bin"
CONFIG_DIR="$ROOT/etc/3m-ui"
CONFIG_FILE="$CONFIG_DIR/config.yaml"
CERT_DIR="$CONFIG_DIR/certs"
MENU_CONF="$CONFIG_DIR/menu.conf"
DATA_DIR="${THREE_M_UI_DATA_DIR:-}"
if [ -z "$DATA_DIR" ] && [ -s "$BASE/DATA_DIRECTORY" ]; then
    DATA_DIR="$(cat "$BASE/DATA_DIRECTORY")"
fi
DATA_DIR="${DATA_DIR:-$ROOT/var/lib/3m-ui}"

# --- helpers -----------------------------------------------------------------

# --- colours ----------------------------------------------------------------
# Same palette the 3x-ui menu uses: green keys/titles, red errors, yellow
# warnings, plain body text. Only enabled when the matching stream is a real
# terminal, so redirected or piped output stays free of escape sequences.
CLR_G=''; CLR_R=''; CLR_Y=''; CLR_B=''; CLR_P=''
_clr_init() {
    if [ -t 2 ] && [ -n "${TERM:-}" ] && [ "${TERM:-}" != dumb ]; then
        CLR_G=$(printf '\033[0;32m')
        CLR_R=$(printf '\033[0;31m')
        CLR_Y=$(printf '\033[0;33m')
        CLR_B=$(printf '\033[0;34m')
        CLR_P=$(printf '\033[0m')
    fi
}
_clr_init

say() { printf '%s\n' "$*"; }
err() { printf '%s%s%s\n' "$CLR_R" "$*" "$CLR_P" >&2; }

need_root() {
    [ "$(id -u)" -eq 0 ] || { err "$(t need_root)"; exit 1; }
}

# --- i18n --------------------------------------------------------------------
# Language: THREE_M_UI_LANG > menu.conf > locale autodetect > zh (default)

LANG_CODE=''

menu_conf_get() {
    # menu_conf_get KEY -> value (empty when unset)
    [ -f "$MENU_CONF" ] || return 0
    awk -v k="$1" '
        /^[[:space:]]*#/ { next }
        {
            line=$0
            sub(/[[:space:]]*#.*/, "", line)
            p = index(line, "=")
            if (p == 0) next
            key = substr(line, 1, p-1)
            val = substr(line, p+1)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
            gsub(/^["\047]|["\047]$/, "", val)
            if (key == k) { print val; exit }
        }
    ' "$MENU_CONF"
}

menu_conf_set() {
    # menu_conf_set KEY VALUE  (atomic-ish rewrite, preserves other keys)
    key=$1
    val=$2
    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    tmp="${MENU_CONF}.tmp.$$"
    : > "$tmp"
    found=0
    if [ -f "$MENU_CONF" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            case "$line" in
                "$key="*)
                    printf '%s=%s\n' "$key" "$val" >> "$tmp"
                    found=1
                    ;;
                *) printf '%s\n' "$line" >> "$tmp" ;;
            esac
        done < "$MENU_CONF"
    fi
    [ "$found" -eq 1 ] || printf '%s=%s\n' "$key" "$val" >> "$tmp"
    mv "$tmp" "$MENU_CONF"
}

detect_lang() {
    # locale-based detection: any zh* locale -> zh, otherwise en
    for v in "${THREE_M_UI_LANG:-}" "${LC_ALL:-}" "${LC_MESSAGES:-}" "${LANG:-}"; do
        case "$v" in
            zh|zh_*|zh_CN*|zh_TW*|zh_HK*) printf 'zh'; return 0 ;;
        esac
    done
    case "${THREE_M_UI_LANG:-}" in
        zh|en) printf '%s' "${THREE_M_UI_LANG}"; return 0 ;;
    esac
    printf ''
}

lang_init() {
    # precedence: THREE_M_UI_LANG (explicit override) > menu.conf > autodetect
    # "auto" explicitly ignores the persisted value and re-detects, matching
    # how THREE_M_UI_TUI overrides the saved UI mode.
    code=''
    case "${THREE_M_UI_LANG:-}" in
        zh|en) code="$THREE_M_UI_LANG" ;;
        auto)  code=$(detect_lang) ;;
    esac
    [ -n "$code" ] || code=$(menu_conf_get lang)
    [ -n "$code" ] || code=$(detect_lang)
    case "$code" in
        zh|en) LANG_CODE="$code" ;;
        *) LANG_CODE=zh ;;
    esac
}

lang_init

t() {
    # t KEY -> localized string (falls back to the key itself)
    key=$1
    case "$LANG_CODE" in
        en) _t_en "$key" ;;
        *)  _t_zh "$key" ;;
    esac
}

